# Copia este archivo a supabase/.env y rellénalo (NO se commitea).
# Settings → API en tu proyecto de Supabase.

# URL del proyecto (https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# service_role key — SECRETA. Solo para el seeder/backend. NUNCA en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña de los usuarios de demo (opcional; por defecto DemoBoda2026!)
DEMO_PASSWORD=DemoBoda2026!
